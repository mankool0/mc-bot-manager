           <string>No directory selected...</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="browseButton">
          <property name="text">
           <string>Browse...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="executableGroupBox">
     <property name="title">
      <string>PrismLauncher Executable</string>
     </property>
     <layout class="QVBoxLayout" name="executableLayout">
      <item>
       <layout class="QHBoxLayout" name="exePathLayout">
        <item>
         <widget class="QLineEdit" name="executableLineEdit">
          <property name="placeholderText">
           <string>Default: prismlauncher (or browse for executable/enter custom command)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="browseExeButton">
          <property name="text">
           <string>Browse...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="hookGroupBox">
     <property name="title">
      <string>Prism Hook</string>
     </property>
     <layout class="QVBoxLayout" name="hookLayout">
      <item>
       <widget class="QCheckBox" name="useHookCheckBox">
        <property name="text">
         <string>Enable Prism hook (token refresh, no focus stealing)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="minimizeWindowsCheckBox">
        <property name="toolTip">
         <string>Every window Prism opens (its main window, the launch progress dialog, the instance console) starts minimized, so nothing appears on screen when bots launch. Bring Prism up from the taskbar, or with Launch Prism Launcher on X11 and Windows.</string>
        </property>
        <property name="text">
         <string>Keep Prism windows minimized</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="hookNoteLabel">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>When enabled, a shared library is injected into the PrismLauncher process. It refreshes account tokens on demand instead of waiting for Prism's own schedule, and keeps Prism's windows from taking focus when bots launch.</string>
        </property>
        <property name="styleSheet">
         <string notr="true">color: gray;</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="clientModGroupBox">
     <property name="title">
      <string>Client Mod</string>
     </property>
     <layout class="QVBoxLayout" name="clientModLayout">
      <item>
       <widget class="QCheckBox" name="autoInstallModCheckBox">
        <property name="toolTip">
         <string>Before a bot launches, its instance gets the client mod jar built for that instance's Minecraft version. Any other mc-bot-client jar in the instance is removed first. Instances running a Minecraft version this manager has no client mod for are left alone.</string>
        </property>
        <property name="text">
         <string>Install the matching client mod before launching a bot</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="syncModsLayout">
        <item>
         <widget class="QPushButton" name="syncModsButton">
          <property name="toolTip">
           <string>Update every instance used by a configured bot now, without launching anything.</string>
          </property>
          <property name="text">
           <string>Sync client mod now</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="clientModVersionLabel">
          <property name="text">
