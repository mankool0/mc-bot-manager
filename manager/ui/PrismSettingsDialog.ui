  <property name="windowTitle">
   <string>PrismLauncher Settings</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="pathGroupBox">
     <property name="title">
      <string>PrismLauncher Directory</string>
     </property>
     <layout class="QVBoxLayout" name="pathLayout">
      <item>
       <layout class="QHBoxLayout" name="directoryLayout">
        <item>
         <widget class="QLineEdit" name="pathLineEdit">
          <property name="readOnly">
           <bool>true</bool>
          </property>
